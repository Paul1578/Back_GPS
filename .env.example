# =====================
# DATABASE CONFIG
# =====================
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=fletflow
DB_USER=root
DB_PASSWORD=replace-with-a-strong-local-database-password

# =====================
# MYSQL DOCKER
# =====================
MYSQL_ROOT_PASSWORD=replace-with-a-strong-local-database-password
MYSQL_DATABASE=fletflow

# =====================
# API SECURITY
# =====================
# Generate a unique value locally; never commit the real value.
Jwt__Key=replace-with-a-random-secret-of-at-least-32-bytes

# =====================
# EMAIL (optional in local development)
# =====================
Email__From=
Email__SmtpHost=
Email__SmtpPort=587
Email__EnableSsl=true
Email__User=
Email__Password=
Email__ResetPasswordUrl=http://localhost:3000/reset-password
Email__ActivationUrl=http://localhost:3000/activate-account

# Optional one-time local bootstrap. Never commit real values.
FLETFLOW_BOOTSTRAP_ADMIN_EMAIL=
FLETFLOW_BOOTSTRAP_ADMIN_PASSWORD=
